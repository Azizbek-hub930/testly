##############################################################################
# Testly — environment variables
#
# Copy to `.env` for local development:
#     cp .env.example .env
#
# In production set the same variables in your Vercel project
# (Settings → Environment Variables).
#
# RULE: every `VITE_`-prefixed value is compiled into the browser bundle and is
# therefore PUBLIC. Never give a `VITE_` prefix to a service-role key, an admin
# secret or an AI provider key.
##############################################################################

# ---------------------------------------------------------------------------
# Supabase — public client credentials  (REQUIRED)
#
# Supabase dashboard → Project Settings → API
#   VITE_SUPABASE_URL       "Project URL"
#   VITE_SUPABASE_ANON_KEY  "anon" / "publishable" key
#
# The anon key is designed to be public: every table is protected by Row Level
# Security, so it grants nothing beyond what the policies in
# supabase/migrations/ allow.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Site URL  (OPTIONAL)
#
# Where Supabase sends users back after OAuth sign-in and password-reset
# emails. Leave blank and the app uses the current browser origin, which is
# correct for localhost, Vercel previews and production alike. Set it only if
# you need to force one canonical origin.
# ---------------------------------------------------------------------------
# VITE_SITE_URL=https://testly.example.com

# ---------------------------------------------------------------------------
# Supabase — service role  (SERVER ONLY, no VITE_ prefix)
#
# Supabase dashboard → Project Settings → API → "service_role" key.
# Used only inside server functions: verifying the caller's JWT, extracting the
# text of uploaded PDFs, writing generated questions, and letting an existing
# admin promote another user.
#
# This key bypasses Row Level Security. It must never reach the browser.
# Without it the app still runs; PDF text extraction, the generation pipeline
# and admin role management are disabled and say so. Uploaded files stay usable,
# they just aren't indexed.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# AI provider  (SERVER ONLY)
#
# "mock"      — deterministic development generator. Clearly labelled as such
#               everywhere it appears in the UI. This is the default.
# "anthropic" — real generation via the Claude API. Requires ANTHROPIC_API_KEY.
#
# See src/server/ai/README.md for how to add a provider.
# ---------------------------------------------------------------------------
AI_PROVIDER=mock
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
